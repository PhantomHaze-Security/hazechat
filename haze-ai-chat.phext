meta.name "Haze AI Chat"
meta.id "phantomhaze.aichat"
meta.version "1.0.0"
meta.description "A polished AI chat panel for PhantomHaze, powered by OpenRouter (openrouter/auto)."
meta.icon "data:image/png;base64,"

// ---- Settings: Settings -> Extensions -> Haze AI Chat ----
setting.text   apiKey       "OpenRouter API key (sk-or-...)"  ""
setting.text   model        "Model slug"                      "openrouter/auto"
setting.text   systemPrompt "System prompt"                   "You are Haze AI, a helpful assistant running inside the PhantomHaze browser. Be concise and format answers in Markdown."
setting.number maxTokens    "Max reply tokens"                1024 64 8192

app.log "Loaded {{extension.name}} v{{extension.version}}"

// ---- Web View: floating sparkle button that summarizes the current page ----
web.script aiSummarize "*" document-end <<JS
(() => {
  if (window.top !== window.self) return;            // top frame only
  if (document.getElementById("ph-ai-fab")) return;  // inject once per page
  const S = (phantomHazeExtension && phantomHazeExtension.settings) || {};
  const ENDPOINT = "https://openrouter.ai/api/v1/chat/completions";
  const css = (el, text) => { el.style.cssText = text; };

  // Floating ✨ button (bottom-left, to avoid the extension launcher at bottom-right)
  const fab = document.createElement("button");
  fab.id = "ph-ai-fab";
  fab.type = "button";
  fab.textContent = "✨";
  fab.title = "Summarize this page with Haze AI";
  css(fab, "all:initial; position:fixed; left:18px; bottom:18px; z-index:2147483646;"
    + "width:46px; height:46px; border-radius:50%; border:0; cursor:pointer;"
    + "font-size:20px; text-align:center; color:#fff; font-family:system-ui,sans-serif;"
    + "background:linear-gradient(135deg,#4f8cff,#7a5cff);"
    + "box-shadow:0 6px 20px rgba(122,92,255,.45); transition:transform .12s;");
  fab.onmouseenter = () => { fab.style.transform = "scale(1.08)"; };
  fab.onmouseleave = () => { fab.style.transform = "scale(1)"; };
  (document.body || document.documentElement).appendChild(fab);

  function dismiss(){ const b = document.getElementById("ph-ai-banner"); if (b) b.remove(); }

  function makeBanner(){
    dismiss();
    const wrap = document.createElement("div");
    wrap.id = "ph-ai-banner";
    css(wrap, "all:initial; position:fixed; left:12px; right:12px; top:12px; margin:0 auto; z-index:2147483647;"
      + "max-width:720px; background:#171b22; color:#e9edf4; border:1px solid #2a3140;"
      + "border-radius:12px; box-shadow:0 12px 40px rgba(0,0,0,.5); padding:14px 16px;"
      + "font-family:system-ui,-apple-system,sans-serif; font-size:14px; line-height:1.55;");
    const head = document.createElement("div");
    css(head, "all:initial; display:flex; align-items:center; gap:8px; margin-bottom:8px; font-family:inherit;");
    const title = document.createElement("div");
    title.textContent = "✨ Page summary";
    css(title, "all:initial; flex:1; font-family:inherit; font-weight:700; font-size:14px; color:#c9b6ff;");
    const x = document.createElement("button");
    x.type = "button"; x.textContent = "✕"; x.title = "Dismiss";
    css(x, "all:initial; cursor:pointer; font-family:inherit; font-size:15px; color:#8a93a4; padding:2px 7px; border-radius:6px;");
    x.onmouseenter = () => { x.style.color = "#e9edf4"; };
    x.onmouseleave = () => { x.style.color = "#8a93a4"; };
    x.onclick = dismiss;
    head.appendChild(title); head.appendChild(x);
    const body = document.createElement("div");
    body.id = "ph-ai-banner-body";
    css(body, "all:initial; font-family:inherit; font-size:14px; line-height:1.6; color:#dfe4ee; white-space:pre-wrap; word-break:break-word;");
    wrap.appendChild(head); wrap.appendChild(body);
    (document.body || document.documentElement).appendChild(wrap);
    return body;
  }

  async function summarize(){
    const body = makeBanner();
    if (!S.apiKey){ body.style.color = "#ff9b9b"; body.textContent = "No API key set. Open Settings → Extensions → Haze AI Chat and paste your OpenRouter key."; return; }
    body.textContent = "Summarizing this page…";
    fab.disabled = true; fab.style.opacity = "0.5";
    const pageText = ((document.body && document.body.innerText) || "").slice(0, 12000);
    const prompt = "Summarize this web page in 3-5 concise bullet points. Begin directly with the bullets, no preamble.\n\n"
      + "Title: " + document.title + "\nURL: " + location.href + "\n\nContent:\n" + pageText;
    try {
      const res = await fetch(ENDPOINT, {
        method: "POST",
        headers: { "Authorization": "Bearer " + S.apiKey, "Content-Type": "application/json" },
        body: JSON.stringify({
          model: S.model || "openrouter/auto",
          messages: [
            { role: "system", content: "You are a concise assistant that summarizes web pages into clear, skimmable bullet points." },
            { role: "user", content: prompt }
          ],
          max_tokens: 400
        })
      });
      if (!res.ok){ const t = await res.text(); body.style.color = "#ff9b9b"; body.textContent = "Error " + res.status + ": " + t.slice(0, 300); return; }
      const data = await res.json();
      const out = (data && data.choices && data.choices[0] && data.choices[0].message && data.choices[0].message.content) || "(empty response)";
      body.textContent = out;
    } catch (e){
      body.style.color = "#ff9b9b";
      body.textContent = "Couldn't reach OpenRouter from this page. The site's security policy (CSP) may block it, or the network failed. " + (e && e.message ? e.message : e);
    } finally {
      fab.disabled = false; fab.style.opacity = "1";
    }
  }

  fab.onclick = summarize;
})();
JS

ui.title "Haze AI Chat"
ui.size 460 640
ui.html <<HTML
<style>
  :root {
    color-scheme: dark;
    --bg:#0e1014; --bg-2:#12151b; --surface:#1a1f28; --surface-2:#222835; --border:#262c38;
    --text:#e9edf4; --muted:#889; --muted-2:#6b7382; --accent:#5b8cff;
    --user-grad:linear-gradient(135deg,#4f8cff 0%,#7a5cff 100%); --ok:#3ecf8e; --warn:#f0a94c;
  }
  * { box-sizing:border-box; }
  html,body { height:100%; }
  body {
    margin:0; font-family:"Inter","Segoe UI",system-ui,-apple-system,sans-serif;
    background:
      radial-gradient(1200px 600px at 100% -10%, rgba(122,92,255,.10), transparent 60%),
      radial-gradient(1000px 500px at -10% 110%, rgba(79,140,255,.10), transparent 60%),
      var(--bg);
    color:var(--text); height:100vh; display:flex; flex-direction:column; -webkit-font-smoothing:antialiased;
  }
  header { display:flex; align-items:center; gap:11px; padding:13px 15px; border-bottom:1px solid var(--border); background:rgba(18,21,27,.7); backdrop-filter:blur(12px); }
  .logo { width:32px; height:32px; border-radius:9px; background:var(--user-grad); display:grid; place-items:center; box-shadow:0 4px 14px rgba(91,140,255,.35); flex-shrink:0; }
  .logo svg { width:18px; height:18px; }
  .htitle { font-size:15px; font-weight:650; letter-spacing:.2px; }
  .hsub { display:flex; align-items:center; gap:6px; font-size:11.5px; color:var(--muted-2); margin-top:1px; }
  .sdot { width:6px; height:6px; border-radius:50%; background:var(--ok); box-shadow:0 0 8px var(--ok); }
  .sdot.off { background:var(--warn); box-shadow:0 0 8px var(--warn); }
  .hspace { flex:1; }
  .iconbtn { width:34px; height:34px; border-radius:9px; border:1px solid var(--border); background:var(--surface); color:var(--muted); cursor:pointer; display:grid; place-items:center; transition:.15s; }
  .iconbtn:hover { background:var(--surface-2); color:var(--text); }
  .iconbtn svg { width:16px; height:16px; }

  #log { flex:1; overflow-y:auto; padding:18px 15px 8px; display:flex; flex-direction:column; gap:14px; scroll-behavior:smooth; }
  #log::-webkit-scrollbar { width:9px; }
  #log::-webkit-scrollbar-thumb { background:#2a3140; border-radius:10px; border:2px solid var(--bg); }
  #log::-webkit-scrollbar-thumb:hover { background:#343c4d; }

  .row { display:flex; gap:10px; align-items:flex-end; animation:rise .28s ease both; }
  .row.user { flex-direction:row-reverse; }
  @keyframes rise { from { opacity:0; transform:translateY(8px);} to { opacity:1; transform:none; } }
  .avatar { width:28px; height:28px; border-radius:8px; flex-shrink:0; display:grid; place-items:center; margin-bottom:2px; }
  .avatar.bot { background:linear-gradient(135deg,#232a37,#2b3344); border:1px solid var(--border); }
  .avatar.bot svg { width:15px; height:15px; color:var(--accent); }
  .row.user .avatar { display:none; }

  .bubble { max-width:78%; padding:10px 13px; border-radius:15px; font-size:14px; line-height:1.5; word-wrap:break-word; overflow-wrap:anywhere; }
  .user .bubble { background:var(--user-grad); color:#fff; border-bottom-right-radius:5px; box-shadow:0 6px 18px rgba(91,110,255,.28); }
  .bot .bubble { background:var(--surface); border:1px solid var(--border); border-bottom-left-radius:5px; }
  .bubble p { margin:0 0 8px; } .bubble p:last-child { margin-bottom:0; }
  .bubble code { background:rgba(255,255,255,.08); padding:1.5px 5px; border-radius:5px; font-family:"JetBrains Mono",ui-monospace,monospace; font-size:12.5px; }
  .bubble pre { background:#0c0f14; border:1px solid var(--border); border-radius:10px; padding:11px 12px; overflow-x:auto; margin:8px 0; font-size:12.5px; }
  .bubble pre code { background:none; padding:0; color:#d6def0; }
  .bubble ul, .bubble ol { margin:6px 0; padding-left:21px; } .bubble li { margin:3px 0; }
  .bubble a { color:#9db8ff; } .user .bubble a { color:#e9eeff; text-decoration:underline; }
  .cursor { display:inline-block; width:7px; height:14px; background:var(--accent); border-radius:2px; vertical-align:text-bottom; animation:caret 1s steps(1) infinite; margin-left:1px; }
  @keyframes caret { 50% { opacity:0; } }
  .meta { font-size:10.5px; color:var(--muted-2); margin-top:6px; display:flex; gap:7px; align-items:center; }
  .meta .pill { background:rgba(91,140,255,.12); color:#a9c0ff; padding:1px 7px; border-radius:20px; font-weight:600; }
  .err { color:#ff9b9b; }

  .typing { display:flex; gap:4px; padding:4px 2px; }
  .typing span { width:7px; height:7px; border-radius:50%; background:var(--muted); animation:blink 1.3s infinite both; }
  .typing span:nth-child(2){ animation-delay:.2s; } .typing span:nth-child(3){ animation-delay:.4s; }
  @keyframes blink { 0%,60%,100%{ opacity:.25; transform:translateY(0);} 30%{ opacity:1; transform:translateY(-3px);} }

  #empty { flex:1; display:flex; flex-direction:column; align-items:center; justify-content:center; text-align:center; padding:24px; gap:6px; }
  #empty .orb { width:60px; height:60px; border-radius:18px; background:var(--user-grad); display:grid; place-items:center; box-shadow:0 10px 30px rgba(122,92,255,.4); margin-bottom:6px; }
  #empty .orb svg { width:30px; height:30px; }
  #empty h2 { margin:6px 0 2px; font-size:18px; font-weight:680; }
  #empty p { margin:0; color:var(--muted-2); font-size:13px; max-width:280px; line-height:1.5; }
  .chips { display:flex; flex-wrap:wrap; gap:8px; justify-content:center; margin-top:16px; }
  .chip { border:1px solid var(--border); background:var(--surface); color:var(--text); padding:8px 12px; border-radius:11px; font-size:12.5px; cursor:pointer; transition:.15s; }
  .chip:hover { background:var(--surface-2); border-color:#33405a; transform:translateY(-1px); }
  #empty a { color:#9db8ff; text-decoration:none; border-bottom:1px solid rgba(157,184,255,.35); }
  #empty code { background:rgba(255,255,255,.08); padding:1px 5px; border-radius:5px; font-family:ui-monospace,monospace; font-size:12px; }
  .setup { margin-top:18px; display:flex; flex-direction:column; gap:10px; text-align:left; width:100%; max-width:300px; }
  .step { display:flex; gap:10px; align-items:flex-start; font-size:12.5px; color:#b7bdca; line-height:1.45; }
  .step .n { flex-shrink:0; width:20px; height:20px; border-radius:50%; background:var(--surface-2); border:1px solid var(--border); color:#cbd3e1; font-size:11px; font-weight:700; display:grid; place-items:center; margin-top:1px; }

  #bar { padding:12px 14px 14px; border-top:1px solid var(--border); background:rgba(14,16,20,.6); backdrop-filter:blur(10px); }
  .inputwrap { display:flex; align-items:flex-end; gap:9px; background:var(--surface); border:1px solid var(--border); border-radius:15px; padding:7px 7px 7px 13px; transition:border-color .15s, box-shadow .15s; }
  .inputwrap:focus-within { border-color:#3a62c9; box-shadow:0 0 0 3px rgba(91,140,255,.14); }
  #input { flex:1; resize:none; border:0; outline:0; background:none; color:var(--text); font:inherit; font-size:14px; line-height:1.45; max-height:140px; padding:6px 0; }
  #input::placeholder { color:var(--muted-2); }
  #send { width:36px; height:36px; flex-shrink:0; border:0; border-radius:11px; background:var(--user-grad); color:#fff; cursor:pointer; display:grid; place-items:center; transition:.15s; box-shadow:0 4px 12px rgba(91,120,255,.35); }
  #send:hover { filter:brightness(1.08); }
  #send:disabled { opacity:.4; cursor:default; box-shadow:none; filter:none; }
  #send svg { width:17px; height:17px; }
  .foot { text-align:center; font-size:11px; color:#b9a3ff; margin-top:9px; font-weight:600; letter-spacing:.2px; }
</style>

<!-- Settings injected here as HTML attributes/text; the parser decodes entities so special characters survive. -->
<div id="cfg" style="display:none"
     data-model="{{setting.model}}"
     data-sys="{{setting.systemPrompt}}"
     data-max="{{setting.maxTokens}}"></div>
<div id="keyholder" style="display:none">{{setting.apiKey}}</div>

<header>
  <div class="logo"><svg viewBox="0 0 24 24" fill="none"><path d="M12 2l7 3v6c0 4.4-3 8.3-7 9-4-.7-7-4.6-7-9V5l7-3z" fill="#fff" opacity=".95"/></svg></div>
  <div>
    <div class="htitle">Haze AI Chat</div>
    <div class="hsub"><span class="sdot" id="sdot"></span> <span id="statusText">openrouter/auto</span></div>
  </div>
  <div class="hspace"></div>
  <button class="iconbtn" id="newchat" title="New chat">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M5 12h14"/></svg>
  </button>
</header>

<div id="log"></div>

<div id="bar">
  <div class="inputwrap">
    <textarea id="input" rows="1" placeholder="Message Haze AI..."></textarea>
    <button id="send" title="Send">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 19V5M5 12l7-7 7 7"/></svg>
    </button>
  </div>
  <div class="foot">Powered by Gen AI and OpenRouter</div>
</div>

<script>
(() => {
  const cfg = document.getElementById("cfg");
  const API_KEY   = document.getElementById("keyholder").textContent.trim();
  const MODEL     = (cfg.dataset.model || "openrouter/auto").trim();
  const SYSPROMPT = cfg.dataset.sys || "";
  const MAXTOK    = Number(cfg.dataset.max) || 1024;
  const ENDPOINT  = "https://openrouter.ai/api/v1/chat/completions";

  const log = document.getElementById("log");
  const input = document.getElementById("input");
  const sendBtn = document.getElementById("send");
  const sdot = document.getElementById("sdot");
  const statusText = document.getElementById("statusText");
  const BOT_SVG = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2l7 3v6c0 4.4-3 8.3-7 9-4-.7-7-4.6-7-9V5l7-3z"/></svg>';

  let messages = SYSPROMPT ? [{ role:"system", content:SYSPROMPT }] : [];
  let busy = false;

  statusText.textContent = MODEL;
  if (!API_KEY) { sdot.classList.add("off"); statusText.textContent = "No API key set"; }

  // ---------- tiny markdown ----------
  function esc(s){ return s.replace(/[&<>]/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;'}[c])); }
  function md(src){
    const tok = []; const stash = h => { tok.push(h); return '\u0000'+(tok.length-1)+'\u0000'; };
    let s = esc(src);
    s = s.replace(/```(\w*)\n?([\s\S]*?)```/g, (_,lang,c)=> stash('<pre><code>'+c.replace(/\n$/,'')+'</code></pre>'));
    s = s.replace(/`([^`]+)`/g, (_,c)=> stash('<code>'+c+'</code>'));
    s = s.replace(/^[ \t]*\*[ \t]+/gm, '- ');                                   // normalize * bullets to -
    s = s.replace(/^[ \t]*(#{1,6})[ \t]+(.*)$/gm, (_,h,t)=> '<strong>'+t+'</strong>'); // headings -> bold line
    s = s.replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>');
    s = s.replace(/(^|[^*])\*(?!\s)([^*]+?)\*/g, '$1<em>$2</em>');
    s = s.replace(/\[([^\]]+)\]\((https?:[^)]+)\)/g, (_,t,u)=> '<a href="'+u.replace(/"/g,'%22')+'" target="_blank" rel="noopener">'+t+'</a>');
    s = s.replace(/(?:^|\n)((?:- .*(?:\n|$))+)/g, (_,blk)=>{ const items = blk.trim().split('\n').map(l=>'<li>'+l.replace(/^- /,'')+'</li>').join(''); return '\n'+stash('<ul>'+items+'</ul>'); });
    s = s.replace(/(?:^|\n)((?:\d+\. .*(?:\n|$))+)/g, (_,blk)=>{ const items = blk.trim().split('\n').map(l=>'<li>'+l.replace(/^\d+\. /,'')+'</li>').join(''); return '\n'+stash('<ol>'+items+'</ol>'); });
    s = s.split(/\n{2,}/).map(p => p.trim()==='' ? '' : (/^\u0000\d+\u0000$/.test(p.trim()) ? p : '<p>'+p.replace(/\n/g,'<br>')+'</p>')).join('');
    let prev; do { prev = s; s = s.replace(/\u0000(\d+)\u0000/g, (_,i)=>tok[+i]); } while (s !== prev);
    return s;
  }

  // ---------- view helpers ----------
  function showEmpty(){
    const withKey =
        '<p>Your AI assistant, running inside PhantomHaze. Ask anything to get started.</p>'
      + '<div class="chips">'
      + '<div class="chip">Explain a URL pattern</div>'
      + '<div class="chip">Write a request-blocker rule</div>'
      + '<div class="chip">Summarize a topic for me</div>'
      + '</div>';
    const noKey =
        '<p>Connect a free OpenRouter key to start chatting.</p>'
      + '<div class="setup">'
      + '<div class="step"><span class="n">1</span><div>Create an account at <a href="https://openrouter.ai/" target="_blank" rel="noopener">openrouter.ai</a></div></div>'
      + '<div class="step"><span class="n">2</span><div>Generate a key at <a href="https://openrouter.ai/keys" target="_blank" rel="noopener">openrouter.ai/keys</a> (it starts with <code>sk-or-</code>)</div></div>'
      + '<div class="step"><span class="n">3</span><div>Paste it under Settings &rarr; Extensions &rarr; Haze AI Chat</div></div>'
      + '</div>';
    log.innerHTML =
      '<div id="empty">'
      + '<div class="orb"><svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2"><path d="M12 2l7 3v6c0 4.4-3 8.3-7 9-4-.7-7-4.6-7-9V5l7-3z"/></svg></div>'
      + '<h2>Haze AI</h2>'
      + (API_KEY ? withKey : noKey)
      + '</div>';
    log.querySelectorAll(".chip").forEach(c =>
      c.addEventListener("click", () => { input.value = c.textContent; autoGrow(); input.focus(); send(); }));
  }
  function clearEmpty(){ const e = document.getElementById("empty"); if (e) e.remove(); }
  function scroll(){ log.scrollTop = log.scrollHeight; }

  function addUser(text){
    clearEmpty();
    const row = document.createElement("div"); row.className = "row user";
    const b = document.createElement("div"); b.className = "bubble"; b.textContent = text;
    row.appendChild(b); log.appendChild(row); scroll();
  }
  function addBot(){
    clearEmpty();
    const row = document.createElement("div"); row.className = "row bot";
    row.innerHTML = '<div class="avatar bot">'+BOT_SVG+'</div>';
    const b = document.createElement("div"); b.className = "bubble";
    b.innerHTML = '<div class="typing"><span></span><span></span><span></span></div>';
    row.appendChild(b); log.appendChild(row); scroll();
    return b;
  }

  // ---------- send + stream ----------
  async function send(){
    if (busy) return;
    const text = input.value.trim();
    if (!text) return;
    if (!API_KEY){ addUser(text); const b=addBot(); b.innerHTML='<span class="err">No API key set. Open Settings &rarr; Extensions &rarr; Haze AI Chat.</span>'; input.value=''; autoGrow(); return; }

    busy = true; sendBtn.disabled = true;
    input.value = ""; autoGrow();
    addUser(text);
    messages.push({ role:"user", content:text });
    const bubble = addBot();

    let full = "", servedModel = "";
    const render = () => { bubble.innerHTML = md(full) + '<span class="cursor"></span>'; scroll(); };

    try {
      const res = await fetch(ENDPOINT, {
        method:"POST",
        headers:{ "Authorization":"Bearer "+API_KEY, "Content-Type":"application/json" },
        body: JSON.stringify({ model:MODEL, messages:messages, max_tokens:MAXTOK, stream:true })
      });

      if (!res.ok){
        const t = await res.text();
        bubble.innerHTML = '<span class="err">Error '+res.status+': '+esc(t.slice(0,400))+'</span>';
        messages.pop(); return;
      }

      // Stream Server-Sent Events
      const reader = res.body.getReader();
      const dec = new TextDecoder();
      let buf = "";
      while (true){
        const { value, done } = await reader.read();
        if (done) break;
        buf += dec.decode(value, { stream:true });
        let nl;
        while ((nl = buf.indexOf("\n")) >= 0){
          const line = buf.slice(0, nl).trim(); buf = buf.slice(nl+1);
          if (!line.startsWith("data:")) continue;
          const data = line.slice(5).trim();
          if (data === "[DONE]") { buf=""; break; }
          try {
            const j = JSON.parse(data);
            if (j.model) servedModel = j.model;
            const delta = j.choices && j.choices[0] && j.choices[0].delta && j.choices[0].delta.content;
            if (delta){ full += delta; render(); }
          } catch(e){ /* keep partial line for next chunk */ buf = line + "\n" + buf; break; }
        }
      }

      if (!full){ bubble.innerHTML = '<span class="err">(empty response)</span>'; messages.pop(); return; }
      bubble.innerHTML = md(full) + (servedModel ? '<div class="meta"><span class="pill">via '+esc(servedModel)+'</span></div>' : "");
      messages.push({ role:"assistant", content:full });
      scroll();
    } catch(e){
      bubble.innerHTML = '<span class="err">Network error: '+esc(String(e && e.message ? e.message : e))+'</span>';
      messages.pop();
    } finally {
      busy = false; sendBtn.disabled = false; input.focus();
    }
  }

  function autoGrow(){ input.style.height="auto"; input.style.height=Math.min(input.scrollHeight,140)+"px"; }

  sendBtn.addEventListener("click", send);
  input.addEventListener("keydown", e => { if (e.key==="Enter" && !e.shiftKey){ e.preventDefault(); send(); } });
  input.addEventListener("input", autoGrow);
  document.getElementById("newchat").addEventListener("click", () => {
    if (busy) return;
    messages = SYSPROMPT ? [{ role:"system", content:SYSPROMPT }] : [];
    showEmpty(); input.value=""; autoGrow(); input.focus();
  });

  showEmpty(); input.focus();
})();
</script>
HTML
